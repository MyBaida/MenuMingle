# Copy this file to .env.local for local development.
#
# REACT_APP_API_URL is the single source of truth for the backend host
# (see src/config.js). It is read at BUILD time, so restart the dev server
# after changing it.
#
# Development: leave it EMPTY. Requests stay same-origin ('/api/...') and the
#   CRA dev-server proxy (package.json "proxy" -> http://127.0.0.1:8000)
#   forwards them to the local Django backend.
#
# Production (Vercel): set it to your deployed backend URL, e.g.
#   REACT_APP_API_URL=https://served-backend.onrender.com
REACT_APP_API_URL=
